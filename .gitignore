# CMake build directory (pure intermediate — .o files, CMakeCache.txt with
# absolute paths. Not portable; scripts/build.sh regenerates it in seconds.)
build/

# Third-party library SOURCE/build trees (tarballs + autotools/meson build
# litter — hundreds of MB, fully re-fetched by scripts/build_thirdparty.sh).
# The compiled result (thirdparty/install/) IS tracked — see below.
thirdparty/src/

